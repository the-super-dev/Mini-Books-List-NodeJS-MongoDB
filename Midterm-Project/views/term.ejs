<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Terms of Service - Mini Book List App</title>
  <link rel="icon" href="/images/favicon.ico">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary-color: #667eea;
      --secondary-color: #764ba2;
      --accent-color: #f093fb;
      --text-color: #2c3e50;
      --bg-color: #ffffff;
      --card-bg: #ffffff;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    [data-theme="dark"] {
      --primary-color: #8a9bff;
      --secondary-color: #9d6bd6;
      --accent-color: #ff8ce6;
      --text-color: #f8f9fa;
      --bg-color: #1a1d23;
      --card-bg: #2d3748;
      --shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);
      color: var(--text-color);
      min-height: 100vh;
      transition: all 0.4s ease;
      line-height: 1.6;
    }

    [data-theme="dark"] body {
      background: linear-gradient(135deg, #1a1d23 0%, #2d3748 100%);
    }

    .terms-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    .terms-header {
      text-align: center;
      margin-bottom: 3rem;
      position: relative;
    }

    .terms-title {
      font-size: 3.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 1.5rem;
      animation: fadeInUp 0.8s ease;
    }

    .terms-subtitle {
      font-size: 1.3rem;
      color: #6c757d;
      max-width: 600px;
      margin: 0 auto;
      animation: fadeInUp 0.8s ease 0.2s both;
    }

    .terms-card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 3rem;
      box-shadow: var(--shadow);
      margin-bottom: 2rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      animation: fadeInUp 0.8s ease 0.4s both;
    }

    .terms-intro {
      font-size: 1.2rem;
      text-align: center;
      margin-bottom: 2.5rem;
      color: #6c757d;
      font-weight: 500;
      padding: 0 2rem;
    }

    .terms-list {
      list-style: none;
      padding: 0;
      margin: 2.5rem 0;
    }

    .term-item {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 2rem;
      margin-bottom: 1.5rem;
      background: rgba(102, 126, 234, 0.05);
      border-radius: 15px;
      border-left: 4px solid var(--primary-color);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .term-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
      transition: left 0.6s ease;
    }

    .term-item:hover::before {
      left: 100%;
    }

    .term-item:hover {
      background: rgba(102, 126, 234, 0.1);
      transform: translateX(10px);
    }

    .term-number {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 1.2rem;
      flex-shrink: 0;
      transition: all 0.3s ease;
    }

    .term-item:hover .term-number {
      transform: scale(1.1);
    }

    .term-content {
      flex: 1;
    }

    .term-title {
      font-weight: 600;
      font-size: 1.2rem;
      color: var(--primary-color);
      margin-bottom: 0.8rem;
    }

    .term-description {
      color: var(--text-color);
      margin: 0;
      opacity: 0.9;
    }

    .agreement-section {
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
      border-radius: 15px;
      padding: 2.5rem;
      text-align: center;
      border: 1px solid rgba(102, 126, 234, 0.2);
      margin: 2.5rem 0;
      position: relative;
      overflow: hidden;
    }

    .agreement-section::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .agreement-section:hover::before {
      opacity: 1;
    }

    .agreement-icon {
      font-size: 3rem;
      color: var(--primary-color);
      margin-bottom: 1rem;
    }

    .agreement-text {
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--primary-color);
      margin: 0;
    }

    .back-home {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: white;
      padding: 1rem 2rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
      margin-top: 1rem;
    }

    .back-home:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
      color: white;
      text-decoration: none;
    }

    /* Animations */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Decorative Elements */
    .floating-documents {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: -1;
    }

    .floating-doc {
      position: absolute;
      font-size: 2rem;
      opacity: 0.05;
      animation: float 8s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-25px) rotate(5deg); }
    }

    .floating-doc:nth-child(1) { top: 10%; left: 5%; animation-delay: 0s; }
    .floating-doc:nth-child(2) { top: 20%; right: 10%; animation-delay: 2s; }
    .floating-doc:nth-child(3) { bottom: 30%; left: 10%; animation-delay: 4s; }
    .floating-doc:nth-child(4) { bottom: 20%; right: 5%; animation-delay: 6s; }
    .floating-doc:nth-child(5) { top: 50%; left: 15%; animation-delay: 1s; }
    .floating-doc:nth-child(6) { top: 60%; right: 15%; animation-delay: 3s; }

    /* Additional Sections */
    .policy-section {
      margin-bottom: 2.5rem;
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--primary-color);
      margin-bottom: 1.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid rgba(102, 126, 234, 0.2);
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .update-notice {
      background: rgba(255, 193, 7, 0.1);
      border: 1px solid rgba(255, 193, 7, 0.2);
      border-radius: 12px;
      padding: 1.5rem;
      margin: 2rem 0;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .update-icon {
      font-size: 2rem;
      color: #ffc107;
      flex-shrink: 0;
    }

    .update-text {
      color: var(--text-color);
      margin: 0;
      font-weight: 500;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .terms-title {
        font-size: 2.5rem;
      }
      
      .terms-subtitle {
        font-size: 1.1rem;
      }
      
      .terms-card {
        padding: 2rem 1.5rem;
      }
      
      .term-item {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
        padding: 1.5rem;
      }
      
      .term-number {
        align-self: center;
      }
      
      .terms-intro {
        padding: 0;
      }
    }

    /* Legal Badge */
    .legal-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      background: rgba(102, 126, 234, 0.1);
      color: var(--primary-color);
      padding: 0.8rem 1.5rem;
      border-radius: 25px;
      font-weight: 600;
      margin: 1rem 0 2rem;
      border: 1px solid rgba(102, 126, 234, 0.2);
    }

    /* Terms Summary */
    .terms-summary {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin: 2.5rem 0;
    }

    .summary-item {
      text-align: center;
      padding: 1.5rem;
      background: rgba(255, 255, 255, 0.5);
      border-radius: 15px;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    [data-theme="dark"] .summary-item {
      background: rgba(255, 255, 255, 0.05);
    }

    .summary-item:hover {
      transform: translateY(-5px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .summary-icon {
      font-size: 2.5rem;
      color: var(--primary-color);
      margin-bottom: 1rem;
    }

    .summary-title {
      font-weight: 600;
      color: var(--text-color);
      margin-bottom: 0.5rem;
    }

    .summary-description {
      font-size: 0.9rem;
      color: #6c757d;
      margin: 0;
    }
  </style>
</head>
<body data-theme="light">
  <!-- Decorative Background Elements -->
  <div class="floating-documents">
    <div class="floating-doc">📜</div>
    <div class="floating-doc">📚</div>
    <div class="floating-doc">⚖️</div>
    <div class="floating-doc">📝</div>
    <div class="floating-doc">🔒</div>
    <div class="floating-doc">💫</div>
  </div>

  <div class="terms-container">
    <!-- Header Section -->
    <div class="terms-header">
      <h1 class="terms-title">
        <i class="fas fa-file-contract me-3"></i>Terms of Service
      </h1>
      <p class="terms-subtitle">
        Please read these terms carefully before using Mini Book List App
      </p>
      
      <div class="legal-badge">
        <i class="fas fa-balance-scale"></i>
        Last Updated: <%= new Date().toLocaleDateString() %>
      </div>
    </div>

    <!-- Main Terms Content -->
    <div class="terms-card">
      <!-- Introduction -->
      <div class="terms-intro">
        Welcome to Mini Book List App! By accessing or using our service, 
        you agree to be bound by the following terms and conditions.
      </div>

      <!-- Terms Summary -->
      <div class="terms-summary">
        <div class="summary-item">
          <div class="summary-icon">
            <i class="fas fa-user-check"></i>
          </div>
          <div class="summary-title">Responsible Use</div>
          <div class="summary-description">Use the app respectfully and responsibly</div>
        </div>
        
        <div class="summary-item">
          <div class="summary-icon">
            <i class="fas fa-copyright"></i>
          </div>
          <div class="summary-title">Legal Content</div>
          <div class="summary-description">Only upload lawful materials</div>
        </div>
        
        <div class="summary-item">
          <div class="summary-icon">
            <i class="fas fa-shield-alt"></i>
          </div>
          <div class="summary-title">Limited Liability</div>
          <div class="summary-description">Understand our liability terms</div>
        </div>
      </div>

      <!-- Terms List -->
      <ol class="terms-list">
        <li class="term-item">
          <div class="term-number">1</div>
          <div class="term-content">
            <div class="term-title">Responsible Usage</div>
            <p class="term-description">
              You agree to use the Mini Book List App responsibly and respectfully. 
              This includes maintaining appropriate conduct and not engaging in any activities 
              that may disrupt the service or harm other users' experience.
            </p>
          </div>
        </li>

        <li class="term-item">
          <div class="term-number">2</div>
          <div class="term-content">
            <div class="term-title">Content Guidelines</div>
            <p class="term-description">
              Do not upload, store, or share any illegal, copyrighted, or inappropriate materials. 
              You are solely responsible for the content you add to your book lists and must ensure 
              it complies with all applicable laws and regulations.
            </p>
          </div>
        </li>

        <li class="term-item">
          <div class="term-number">3</div>
          <div class="term-content">
            <div class="term-title">Liability Disclaimer</div>
            <p class="term-description">
              The app creators and developers are not liable for any data loss, misuse, 
              or damages arising from the use of this service. While we strive to maintain 
              service availability, we cannot guarantee uninterrupted access.
            </p>
          </div>
        </li>

        <li class="term-item">
          <div class="term-number">4</div>
          <div class="term-content">
            <div class="term-title">Terms Updates</div>
            <p class="term-description">
              We reserve the right to update or modify these terms at any time without prior notice. 
              Continued use of the app after changes constitutes acceptance of the updated terms. 
              We encourage periodic review of this document.
            </p>
          </div>
        </li>
      </ol>

      <!-- Update Notice -->
      <div class="update-notice">
        <div class="update-icon">
          <i class="fas fa-exclamation-triangle"></i>
        </div>
        <p class="update-text">
          <strong>Important:</strong> These terms may be updated periodically. 
          It is your responsibility to review them regularly for any changes.
        </p>
      </div>

      <!-- Agreement Section -->
      <div class="agreement-section">
        <div class="agreement-icon">
          <i class="fas fa-handshake"></i>
        </div>
        <p class="agreement-text">
          By using Mini Book List App, you acknowledge that you have read, 
          understood, and agree to be bound by these Terms of Service
        </p>
      </div>

      <!-- Additional Information -->
      <div class="policy-section">
        <h3 class="section-title">
          <i class="fas fa-question-circle"></i>
          Questions About Our Terms?
        </h3>
        <p style="color: #6c757d; margin-bottom: 0;">
          If you have any questions or concerns about these terms, please contact us. 
          We're committed to providing a safe and enjoyable experience for all users.
        </p>
      </div>
    </div>

    <!-- Back to Home Button -->
    <div class="text-center">
      <a href="/" class="back-home">
        <i class="fas fa-arrow-left me-2"></i>
        Back to Home
      </a>
    </div>
  </div>

  <script>
    // Theme detection (if you have theme system)
    const currentTheme = localStorage.getItem('theme') || 'light';
    document.body.setAttribute('data-theme', currentTheme);

    // Add hover effects
    document.querySelectorAll('.term-item').forEach(item => {
      item.addEventListener('mouseenter', function() {
        this.style.transform = 'translateX(10px)';
      });
      
      item.addEventListener('mouseleave', function() {
        this.style.transform = 'translateX(0)';
      });
    });

    // Add loading animation
    document.addEventListener('DOMContentLoaded', function() {
      const elements = document.querySelectorAll('.term-item, .summary-item');
      elements.forEach((element, index) => {
        element.style.animation = `fadeInUp 0.6s ease ${index * 0.1}s both`;
      });
    });

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  </script>
</body>
</html>