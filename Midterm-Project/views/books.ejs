<%- include('partials/header') %>

<div class="books-container">
  <!-- Header Section -->
  <div class="books-header">
    <div class="header-content">
      <h1 class="page-title">Book Collection</h1>
      <p class="page-subtitle">Manage and explore your personal library</p>
    </div>
    <div class="header-actions">
      <a href="/add" class="btn-add-book">
        <i class="fas fa-plus-circle me-2"></i>Add New Book
      </a>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">
        <i class="fas fa-book"></i>
      </div>
      <div class="stat-info">
        <h3><%= books.length %></h3>
        <p>Total Books</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">
        <i class="fas fa-user-edit"></i>
      </div>
      <div class="stat-info">
        <h3><%= new Set(books.map(b => b.author)).size %></h3>
        <p>Unique Authors</p>
      </div>
    </div>
  </div>

  <!-- Search Section -->
  <div class="search-section">
    <div class="search-box">
      <i class="fas fa-search search-icon"></i>
      <input type="text" id="searchInput" placeholder="Search books by title, author, or description..." class="search-input">
      <div class="search-actions">
        <button class="btn-clear-search" id="clearSearch" title="Clear search">
          <i class="fas fa-times"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Books List -->
  <div class="books-list-container" id="booksContainer">
    <div class="books-list" id="booksList">
      <% books.forEach(book => { %>
        <div class="list-item" data-title="<%= book.title.toLowerCase() %>" data-author="<%= book.author.toLowerCase() %>" data-description="<%= book.description.toLowerCase() %>">
          <div class="list-item-main">
            <div class="book-image">
              <img src="/uploads/<%= book.image %>" alt="<%= book.title %>" class="book-cover" onerror="this.src='/images/book-placeholder.jpg'">
              <div class="book-overlay">
                <button class="overlay-btn view-btn" onclick="showBookDetails('<%= book._id %>')" title="View Details">
                  <i class="fas fa-eye"></i>
                </button>
              </div>
            </div>
            
            <div class="book-info">
              <div class="book-header">
                <h3 class="book-title"><%= book.title %></h3>
                <span class="book-author">by <%= book.author %></span>
              </div>
              
              <p class="book-description">
                <%= book.description && book.description.length > 120 ? book.description.substring(0, 120) + '...' : book.description || 'No description available' %>
              </p>
              
              <div class="book-meta">
                <% if (book.genre) { %>
                  <span class="book-genre"><%= book.genre %></span>
                <% } %>
                <% if (book.pages) { %>
                  <span class="book-pages"><%= book.pages %> pages</span>
                <% } %>
              </div>
            </div>
            
            <div class="book-actions">
              <button class="action-btn edit-btn" onclick="editBook('<%= book._id %>')" title="Edit Book">
                <i class="fas fa-edit"></i>
                <span class="action-text">Edit</span>
              </button>
              <button class="action-btn delete-btn" onclick="confirmDelete('<%= book._id %>')" title="Delete Book">
                <i class="fas fa-trash"></i>
                <span class="action-text">Delete</span>
              </button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Empty State -->
  <% if (books.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">
        <i class="fas fa-book-open"></i>
      </div>
      <h3>Your Library is Empty</h3>
      <p>Start building your collection by adding your first book!</p>
      <a href="/add" class="btn-add-first">
        <i class="fas fa-plus me-2"></i>Add Your First Book
      </a>
    </div>
  <% } %>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-icon">
          <i class="fas fa-exclamation-triangle text-warning"></i>
        </div>
        <h5 class="modal-title">Delete Book</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete this book? This action cannot be undone.</p>
        <div class="delete-preview" id="deletePreview">
          <!-- Preview will be inserted here -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <a href="#" class="btn btn-danger" id="confirmDelete">Delete Book</a>
      </div>
    </div>
  </div>
</div>

<!-- Toast for Messages -->
<div class="toast-container position-fixed top-0 end-0 p-3">
  <div id="messageToast" class="toast" role="alert">
    <div class="toast-header">
      <i class="fas fa-check-circle text-success me-2"></i>
      <strong class="me-auto">Success</strong>
      <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
    </div>
    <div class="toast-body" id="toastMessage">
      <!-- Message will appear here -->
    </div>
  </div>
</div>

<style>
  :root {
    --primary: #6366f1;
    --primary-dark: #4f46e5;
    --primary-light: #8b5cf6;
    --accent: #06d6a0;
    --text: #1e293b;
    --text-light: #64748b;
    --background: #ffffff;
    --surface: #f8fafc;
    --border: #e2e8f0;
    --shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    --shadow-hover: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    --gradient: linear-gradient(135deg, var(--primary), var(--primary-light));
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
  }

  .books-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .books-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .page-title {
    font-size: 3rem;
    font-weight: 800;
    color: white;
    margin: 0;
    text-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  .page-subtitle {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.2rem;
    margin: 0.5rem 0 0 0;
    font-weight: 400;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .btn-add-book {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(20px);
    color: white;
    padding: 1rem 2rem;
    border-radius: 16px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    transition: var(--transition);
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 1.1rem;
  }

  .btn-add-book:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(255, 255, 255, 0.2);
    color: white;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    padding: 2rem;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: var(--transition);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.15);
  }

  .stat-icon {
    width: 70px;
    height: 70px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.8rem;
    backdrop-filter: blur(10px);
  }

  .stat-info h3 {
    font-size: 2.5rem;
    font-weight: 800;
    color: white;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  .stat-info p {
    color: rgba(255, 255, 255, 0.8);
    margin: 0.5rem 0 0 0;
    font-weight: 500;
    font-size: 1.1rem;
  }

  .search-section {
    margin-bottom: 2rem;
  }

  .search-box {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
  }

  .search-input {
    width: 100%;
    padding: 1.25rem 4rem 1.25rem 3.5rem;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    font-size: 1.1rem;
    transition: var(--transition);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    color: white;
  }

  .search-input::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }

  .search-input:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.15);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
  }

  .search-icon {
    position: absolute;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.1rem;
  }

  .search-actions {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .btn-clear-search {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 50%;
    transition: var(--transition);
    display: none;
  }

  .btn-clear-search:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .books-list-container {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    overflow: hidden;
  }

  .books-list {
    display: flex;
    flex-direction: column;
  }

  .list-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: var(--transition);
    background: transparent;
  }

  .list-item:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateX(8px);
  }

  .list-item:last-child {
    border-bottom: none;
  }

  .list-item-main {
    display: flex;
    align-items: center;
    padding: 2rem;
    gap: 2rem;
  }

  .book-image {
    position: relative;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .book-cover {
    width: 100px;
    height: 140px;
    object-fit: cover;
    border-radius: 12px;
    transition: var(--transition);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .book-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition);
    border-radius: 12px;
  }

  .book-image:hover .book-overlay {
    opacity: 1;
  }

  .book-image:hover .book-cover {
    transform: scale(1.05);
  }

  .overlay-btn {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
    backdrop-filter: blur(10px);
  }

  .overlay-btn:hover {
    background: var(--primary);
    transform: scale(1.1);
  }

  .book-info {
    flex: 1;
    min-width: 0;
  }

  .book-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .book-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: white;
    margin: 0;
    line-height: 1.3;
  }

  .book-author {
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
    font-size: 1rem;
    white-space: nowrap;
  }

  .book-description {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin: 0 0 1rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .book-genre, .book-pages {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .book-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .action-btn {
    padding: 0.75rem 1.25rem;
    border: none;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: var(--transition);
    backdrop-filter: blur(10px);
  }

  .edit-btn {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .edit-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.15);
  }

  .delete-btn {
    background: rgba(239, 68, 68, 0.2);
    color: #fecaca;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .delete-btn:hover {
    background: rgba(239, 68, 68, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(239, 68, 68, 0.2);
  }

  .action-text {
    display: inline;
  }

  .empty-state {
    text-align: center;
    padding: 6rem 2rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .empty-icon {
    font-size: 5rem;
    color: rgba(255, 255, 255, 0.3);
    margin-bottom: 2rem;
  }

  .empty-state h3 {
    color: white;
    margin-bottom: 1rem;
    font-size: 1.8rem;
  }

  .empty-state p {
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .btn-add-first {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(20px);
    color: white;
    padding: 1rem 2rem;
    border-radius: 16px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    transition: var(--transition);
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 1.1rem;
  }

  .btn-add-first:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(255, 255, 255, 0.2);
    color: white;
  }

  /* Toast Styles */
  .toast {
    backdrop-filter: blur(20px);
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
  }

  @media (max-width: 768px) {
    .books-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .header-actions {
      width: 100%;
      justify-content: flex-start;
    }
    
    .list-item-main {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      gap: 1.5rem;
    }
    
    .book-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    
    .book-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    
    .book-actions {
      width: 100%;
      justify-content: flex-end;
      margin-top: 1rem;
    }
    
    .action-text {
      display: none;
    }
    
    .action-btn {
      padding: 0.75rem;
      flex: 1;
      justify-content: center;
    }
    
    .page-title {
      font-size: 2.5rem;
    }
    
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Search functionality
  const searchInput = document.getElementById('searchInput');
  const clearSearch = document.getElementById('clearSearch');

  searchInput.addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const listItems = document.querySelectorAll('.list-item');
    let visibleCount = 0;
    
    listItems.forEach(item => {
      const title = item.getAttribute('data-title');
      const author = item.getAttribute('data-author');
      const description = item.getAttribute('data-description');
      
      if (title.includes(searchTerm) || author.includes(searchTerm) || description.includes(searchTerm)) {
        item.style.display = 'flex';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Show/hide clear button
    clearSearch.style.display = searchTerm ? 'block' : 'none';
  });

  // Clear search functionality
  clearSearch.addEventListener('click', function() {
    searchInput.value = '';
    searchInput.dispatchEvent(new Event('input'));
    clearSearch.style.display = 'none';
  });

  // Show success message
  function showMessage(message) {
    const toast = new bootstrap.Toast(document.getElementById('messageToast'));
    document.getElementById('toastMessage').textContent = message;
    toast.show();
  }

  // Edit book function with confirmation
  function editBook(bookId) {
    const item = document.querySelector(`[onclick="editBook('${bookId}')"]`).closest('.list-item');
    const title = item.querySelector('.book-title').textContent;
    
    // Show confirmation message
    showMessage(`Redirecting to edit "${title}"...`);
    
    // Redirect after a short delay to show the message
    setTimeout(() => {
      window.location.href = `/edit/${bookId}`;
    }, 1000);
  }

  // View book details
  function showBookDetails(bookId) {
    const item = document.querySelector(`[onclick="showBookDetails('${bookId}')"]`).closest('.list-item');
    const title = item.querySelector('.book-title').textContent;
    showMessage(`Viewing details for "${title}"`);
    // You can implement actual detail view modal here
  }

  // Delete confirmation with preview
  function confirmDelete(bookId) {
    const item = document.querySelector(`[onclick="confirmDelete('${bookId}')"]`).closest('.list-item');
    const title = item.querySelector('.book-title').textContent;
    const author = item.querySelector('.book-author').textContent;
    
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    document.getElementById('confirmDelete').href = `/delete/${bookId}`;
    
    // Create preview
    document.getElementById('deletePreview').innerHTML = `
      <div style="display: flex; align-items: center; gap: 1rem;">
        <img src="${item.querySelector('.book-cover').src}" alt="${title}" style="width: 50px; height: 70px; object-fit: cover; border-radius: 6px;">
        <div>
          <strong>${title}</strong><br>
          <small>${author}</small>
        </div>
      </div>
    `;
    
    modal.show();
  }

  // Check if there's a success message from server (e.g., after add/edit)
  document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const message = urlParams.get('message');
    if (message) {
      showMessage(decodeURIComponent(message));
    }
  });
</script>

<%- include('partials/footer') %>