<%- include('partials/header') %>

<div class="home-container">
  <!-- Hero Section -->
  <div class="hero-section">
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-title">Welcome to Mini Book List</h1>
        <p class="hero-subtitle">Discover, organize, and explore your personal library collection</p>
        <div class="hero-actions">
          <a href="/books" class="btn btn-primary">
            <i class="fas fa-book-open me-2"></i>Browse Collection
          </a>
          <a href="/add" class="btn btn-secondary">
            <i class="fas fa-plus me-2"></i>Add New Book
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="floating-books">
          <div class="book-float book-1">
            <i class="fas fa-book"></i>
          </div>
          <div class="book-float book-2">
            <i class="fas fa-book-open"></i>
          </div>
          <div class="book-float book-3">
            <i class="fas fa-bookmark"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="stats-section">
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon">
          <i class="fas fa-book"></i>
        </div>
        <div class="stat-info">
          <h3><%= books.length %></h3>
          <p>Total Books</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">
          <i class="fas fa-user-edit"></i>
        </div>
        <div class="stat-info">
          <h3><%= new Set(books.map(b => b.author)).size %></h3>
          <p>Unique Authors</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">
          <i class="fas fa-tags"></i>
        </div>
        <div class="stat-info">
          <h3>
            <%
              const genres = books.filter(book => book.genre).map(book => book.genre);
              const uniqueGenres = [...new Set(genres)];
            %>
            <%= uniqueGenres.length %>
          </h3>
          <p>Genres</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Books -->
  <div class="featured-section">
    <div class="section-header">
      <h2 class="section-title">Featured Books</h2>
      <p class="section-subtitle">Recently added to your collection</p>
    </div>

    <div class="featured-books">
      <% const featuredBooks = books.slice(0, 6); %>
      <% if (featuredBooks.length > 0) { %>
        <div class="books-grid">
          <% featuredBooks.forEach(book => { %>
            <div class="featured-book-card">
              <div class="book-image">
                <img 
                  src="<%= book.image ? '/uploads/' + book.image : '/images/book-placeholder.jpg' %>" 
                  alt="<%= book.title %>"
                  class="book-cover"
                  onerror="this.src='/images/book-placeholder.jpg'"
                >
                <div class="book-overlay">
                  <div class="overlay-actions">
                    <button class="action-btn view-btn" onclick="location.href='/books'">
                      <i class="fas fa-eye"></i>
                    </button>
                    <button class="action-btn favorite-btn">
                      <i class="far fa-heart"></i>
                    </button>
                  </div>
                </div>
              </div>
              <div class="book-content">
                <h4 class="book-title"><%= book.title %></h4>
                <p class="book-author">by <%= book.author %></p>
                <% if (book.description) { %>
                  <p class="book-description">
                    <%= book.description.length > 80 ? book.description.substring(0, 80) + '...' : book.description %>
                  </p>
                <% } %>
                <div class="book-meta">
                  <% if (book.genre) { %>
                    <span class="book-genre"><%= book.genre %></span>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        
        <div class="view-all-container">
          <a href="/books" class="btn-view-all">
            View All Books <i class="fas fa-arrow-right ms-2"></i>
          </a>
        </div>
      <% } else { %>
        <div class="empty-featured">
          <div class="empty-icon">
            <i class="fas fa-book-open"></i>
          </div>
          <h3>No Books Yet</h3>
          <p>Start building your collection by adding your first book!</p>
          <a href="/add" class="btn-add-first">
            <i class="fas fa-plus me-2"></i>Add Your First Book
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Features Section -->
  <div class="features-section">
    <div class="section-header">
      <h2 class="section-title">Why Use Mini Book List?</h2>
      <p class="section-subtitle">Organize your reading journey with ease</p>
    </div>
    
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">
          <i class="fas fa-search"></i>
        </div>
        <h4>Easy Search</h4>
        <p>Quickly find any book in your collection by title, author, or description</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">
          <i class="fas fa-mobile-alt"></i>
        </div>
        <h4>Responsive Design</h4>
        <p>Access your book collection from any device, anywhere</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">
          <i class="fas fa-plus-circle"></i>
        </div>
        <h4>Easy Management</h4>
        <p>Add, edit, or remove books from your collection with just a few clicks</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">
          <i class="fas fa-image"></i>
        </div>
        <h4>Cover Images</h4>
        <p>Upload book covers to make your collection visually appealing</p>
      </div>
    </div>
  </div>
</div>

<style>
  :root {
    --primary: #6366f1;
    --primary-dark: #4f46e5;
    --primary-light: #8b5cf6;
    --accent: #06d6a0;
    --text: #1e293b;
    --text-light: #64748b;
    --background: #ffffff;
    --surface: #f8fafc;
    --border: #e2e8f0;
    --shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    --shadow-hover: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    --gradient: linear-gradient(135deg, var(--primary), var(--primary-light));
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
  }

  .home-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Hero Section */
  .hero-section {
    padding: 4rem 0;
    color: white;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    text-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  .hero-subtitle {
    font-size: 1.3rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    padding: 1rem 2rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    transition: var(--transition);
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
  }

  .btn-primary {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(20px);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-primary:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(255, 255, 255, 0.2);
  }

  .btn-secondary {
    background: transparent;
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.3);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  /* Floating Books Animation */
  .floating-books {
    position: relative;
    height: 300px;
  }

  .book-float {
    position: absolute;
    width: 80px;
    height: 100px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    animation: float 6s ease-in-out infinite;
  }

  .book-1 {
    top: 20%;
    left: 20%;
    animation-delay: 0s;
  }

  .book-2 {
    top: 50%;
    left: 60%;
    animation-delay: 2s;
  }

  .book-3 {
    top: 10%;
    left: 70%;
    animation-delay: 4s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  /* Stats Section */
  .stats-section {
    margin: 4rem 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    padding: 2rem;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: var(--transition);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.15);
  }

  .stat-icon {
    width: 70px;
    height: 70px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.8rem;
    backdrop-filter: blur(10px);
  }

  .stat-info h3 {
    font-size: 2.5rem;
    font-weight: 800;
    color: white;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  .stat-info p {
    color: rgba(255, 255, 255, 0.8);
    margin: 0.5rem 0 0 0;
    font-weight: 500;
    font-size: 1.1rem;
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  .section-subtitle {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  /* Featured Books */
  .featured-section {
    margin: 6rem 0;
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .featured-book-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    overflow: hidden;
    transition: var(--transition);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .featured-book-card:hover {
    transform: translateY(-8px);
    background: rgba(255, 255, 255, 0.15);
  }

  .book-image {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .book-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .book-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition);
  }

  .book-image:hover .book-overlay {
    opacity: 1;
  }

  .book-image:hover .book-cover {
    transform: scale(1.1);
  }

  .overlay-actions {
    display: flex;
    gap: 0.5rem;
  }

  .action-btn {
    width: 45px;
    height: 45px;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    cursor: pointer;
    transition: var(--transition);
    backdrop-filter: blur(10px);
  }

  .view-btn {
    background: rgba(255, 255, 255, 0.2);
  }

  .view-btn:hover {
    background: var(--primary);
    transform: scale(1.1);
  }

  .favorite-btn {
    background: rgba(255, 255, 255, 0.2);
  }

  .favorite-btn:hover {
    background: #ef4444;
    transform: scale(1.1);
  }

  .book-content {
    padding: 1.5rem;
  }

  .book-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .book-author {
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .book-description {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .book-genre {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .view-all-container {
    text-align: center;
  }

  .btn-view-all {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    color: white;
    padding: 1rem 2rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    transition: var(--transition);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-view-all:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
    color: white;
  }

  /* Empty State */
  .empty-featured {
    text-align: center;
    padding: 4rem 2rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .empty-icon {
    font-size: 4rem;
    color: rgba(255, 255, 255, 0.3);
    margin-bottom: 1.5rem;
  }

  .empty-featured h3 {
    color: white;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .empty-featured p {
    margin-bottom: 2rem;
  }

  .btn-add-first {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(20px);
    color: white;
    padding: 1rem 2rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    transition: var(--transition);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-add-first:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
    color: white;
  }

  /* Features Section */
  .features-section {
    margin: 6rem 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    padding: 2.5rem 2rem;
    border-radius: 20px;
    text-align: center;
    transition: var(--transition);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.15);
  }

  .feature-icon {
    width: 80px;
    height: 80px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: white;
    font-size: 2rem;
  }

  .feature-card h4 {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: white;
  }

  .feature-card p {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-actions {
      justify-content: center;
    }

    .floating-books {
      height: 200px;
    }

    .books-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid,
    .features-grid {
      grid-template-columns: 1fr;
    }

    .section-title {
      font-size: 2rem;
    }
  }
</style>

<script>
  // Favorite button functionality
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.favorite-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const icon = this.querySelector('i');
        icon.classList.toggle('far');
        icon.classList.toggle('fas');
        
        // Add a little animation
        this.style.transform = 'scale(1.2)';
        setTimeout(() => {
          this.style.transform = 'scale(1)';
        }, 300);
      });
    });
  });
</script>

<%- include('partials/footer') %>