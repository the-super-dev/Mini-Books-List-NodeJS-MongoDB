<style>
  .modern-footer {
    background: linear-gradient(135deg, #1a2a3a 0%, #2c3e50 100%);
    color: #ecf0f1;
    padding: 4rem 0 0;
    margin-top: 4rem;
    position: relative;
    overflow: hidden;
  }
  
  .wave-divider {
    position: absolute;
    top: -60px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    transform: rotate(180deg);
  }
  
  .wave-divider svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 60px;
  }
  
  .wave-divider .shape-fill {
    fill: #1a2a3a;
  }
  
  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2.5rem;
    margin-bottom: 2rem;
  }
  
  .brand-container {
    display: flex;
    align-items: center;
    margin-bottom: 1.2rem;
  }
  
  .logo-animation {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #3498db, #9b59b6);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    animation: float 3s ease-in-out infinite;
    box-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  
  .logo-animation i {
    color: white;
    font-size: 1.5rem;
  }
  
  .footer-section h4, .footer-section h5 {
    color: #fff;
    margin-bottom: 1.5rem;
    font-weight: 600;
    position: relative;
  }
  
  .footer-section h5::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 40px;
    height: 3px;
    background: linear-gradient(90deg, #3498db, #9b59b6);
    border-radius: 2px;
  }
  
  .footer-brand {
    font-size: 1.6rem;
    background: linear-gradient(90deg, #3498db, #9b59b6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
  }
  
  .footer-description {
    color: #bdc3c7;
    line-height: 1.6;
    margin-bottom: 1.8rem;
  }
  
  .social-links {
    display: flex;
    gap: 0.8rem;
  }
  
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    color: #ecf0f1;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
  }
  
  .social-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s;
  }
  
  .social-link:hover::before {
    left: 100%;
  }
  
  .social-link:hover {
    transform: translateY(-5px) scale(1.1);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  }
  
  .social-link:nth-child(1):hover { background: #3b5998; }
  .social-link:nth-child(2):hover { background: #1da1f2; }
  .social-link:nth-child(3):hover { background: #e4405f; }
  .social-link:nth-child(4):hover { background: #634c27; }
  
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-links li {
    margin-bottom: 0.8rem;
    overflow: hidden;
  }
  
  .footer-links a {
    color: #bdc3c7;
    text-decoration: none;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    position: relative;
    padding: 5px 0;
  }
  
  .footer-links a span {
    position: relative;
    transition: transform 0.3s ease;
  }
  
  .footer-links a:hover span {
    transform: translateX(10px);
    color: #3498db;
  }
  
  .footer-links a::before {
    content: '›';
    position: absolute;
    left: -15px;
    opacity: 0;
    transition: all 0.3s ease;
    color: #3498db;
  }
  
  .footer-links a:hover::before {
    opacity: 1;
    left: -10px;
  }
  
  .newsletter-text {
    color: #bdc3c7;
    margin-bottom: 1.2rem;
    font-size: 0.9rem;
  }
  
  .newsletter-form {
    margin-bottom: 1.8rem;
  }
  
  .input-group {
    display: flex;
    border-radius: 30px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: all 0.3s ease;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }
  
  .input-group:focus-within {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.15);
    border-color: rgba(52, 152, 219, 0.5);
  }
  
  .input-group .form-control {
    background: transparent;
    border: none;
    color: white;
    padding: 0.85rem 1.2rem;
    flex: 1;
    transition: all 0.3s ease;
  }
  
  .input-group .form-control::placeholder {
    color: #95a5a6;
  }
  
  .input-group .form-control:focus {
    box-shadow: none;
    background: rgba(255, 255, 255, 0.05);
  }
  
  .btn-newsletter {
    background: linear-gradient(135deg, #3498db, #2980b9);
    border: none;
    color: white;
    padding: 0.85rem 1.2rem;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .btn-newsletter::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 5px;
    background: rgba(255, 255, 255, 0.5);
    opacity: 0;
    border-radius: 100%;
    transform: scale(1, 1) translate(-50%);
    transform-origin: 50% 50%;
  }
  
  .btn-newsletter:hover {
    background: linear-gradient(135deg, #2980b9, #3498db);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
  }
  
  .btn-newsletter:focus:not(:active)::after {
    animation: ripple 1s ease-out;
  }
  
  @keyframes ripple {
    0% {
      transform: scale(0, 0);
      opacity: 0.5;
    }
    100% {
      transform: scale(40, 40);
      opacity: 0;
    }
  }
  
  .app-badges {
    display: flex;
    gap: 0.8rem;
  }
  
  .app-badge {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    color: #ecf0f1;
    text-decoration: none;
    padding: 0.6rem 1rem;
    border-radius: 10px;
    font-size: 0.9rem;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .app-badge:hover {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 8px 15px rgba(0,0,0,0.1);
  }
  
  .app-badge i {
    margin-right: 0.5rem;
    font-size: 1.2rem;
  }
  
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.8rem 0;
    position: relative;
  }
  
  .footer-bottom::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(52, 152, 219, 0.5), transparent);
  }
  
  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .footer-bottom p {
    margin: 0;
    color: #95a5a6;
    font-size: 0.9rem;
  }
  
  .footer-legal {
    display: flex;
    gap: 1.8rem;
  }
  
  .footer-legal a {
    color: #bdc3c7;
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    position: relative;
  }
  
  .footer-legal a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background: #3498db;
    transition: width 0.3s ease;
  }
  
  .footer-legal a:hover {
    color: #3498db;
  }
  
  .footer-legal a:hover::after {
    width: 100%;
  }
  
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .footer-bottom-content {
      flex-direction: column;
      text-align: center;
    }
    
    .footer-legal {
      justify-content: center;
    }
    
    .app-badges {
      justify-content: center;
    }
    
    .wave-divider {
      top: -40px;
    }
    
    .wave-divider svg {
      height: 40px;
    }
  }
</style>

